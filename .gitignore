# ============================================================================
# .gitignore - Overwatch 2 Web Protocol Project
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 대용량 바이너리 및 실행 파일 (Large Binaries & Executables)
# ----------------------------------------------------------------------------
# Cloudflare Tunnel 실행 파일 (~55MB, tunnel.py 실행 시 자동 다운로드됨)
cloudflared.exe
*.exe
*.dll
*.so
*.dylib
*.bin

# ----------------------------------------------------------------------------
# 2. 런타임 생성 파일 및 로그 (Runtime Generated Files & Logs)
# ----------------------------------------------------------------------------
# 터널 구동 시 자동 생성되는 접속 링크 파일
public_url.txt
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------------------------------------------------------
# 3. Node.js 의존성 및 패키지 캐시 (Node.js / Dependencies)
# ----------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/

# ----------------------------------------------------------------------------
# 4. Python 캐시 및 가상환경 (Python Caches & Virtual Environments)
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# 가상 환경 (Virtual Environments)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ----------------------------------------------------------------------------
# 5. 환경 변수 및 민감한 정보 (Environment Variables & Secrets)
# ----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# ----------------------------------------------------------------------------
# 6. 운영체제(OS) 생성 불필요 파일
# ----------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# ----------------------------------------------------------------------------
# 7. IDE / 에디터 설정 파일 (IDE & Code Editors)
# ----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
